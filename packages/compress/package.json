{
  "name": "@gravionlabs/kontex-compress",
  "version": "1.0.0",
  "description": "Caveman-style text compression — strips filler, pleasantries, hedges, articles, and abbreviates terms by intensity level",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "exports": {
    ".": "./dist/index.js",
    "./rules": "./dist/compression-rules.json"
  },
  "bin": {
    "caveman-compress": "./bin/caveman-compress.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check --write src/",
    "prepublish": "pnpm build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GravionLabs/kontex.git"
  },
  "files": [
    "dist",
    "bin",
    "src/compression-rules.json"
  ],
  "keywords": [
    "caveman",
    "compression",
    "text",
    "token-optimization",
    "llm"
  ],
  "license": "MIT",
  "dependencies": {
    "@gravionlabs/kontex-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
