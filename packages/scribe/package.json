{
  "name": "@gravionlabs/kontex-scribe",
  "version": "1.0.1",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": "./dist/index.js",
    "./services/compression.js": "./dist/services/compression.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublish": "pnpm build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check --write src/",
    "inspect": "npx @modelcontextprotocol/inspector pnpm run start"
  },
  "dependencies": {
    "@gravionlabs/kontex-compress": "workspace:*",
    "@gravionlabs/kontex-types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.10.0",
    "yaml": "^2.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.22.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "tsx": "^4.19.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
